</textarea>

</div>



<button
    class="btn btn-primary"
    onclick="publishPoetry()">

    ✒️ Publish Poetry

</button>


</div>

</section>

</div>



<!-- =========================
     ABOUT PAGE
========================= -->

<div id="about" class="page">

<section class="section">

<div class="about">

<h1 class="section-title">
    About the Poet
</h1>


<br>


<p>

    I am <strong>Bashudev Upadhyay</strong>,
    a poet and writer who believes that
    words can preserve thoughts, memories
    and emotions.

</p>


<br>


<p>

    <strong>Poet's Poetry</strong> is my
    personal space for sharing poetry
