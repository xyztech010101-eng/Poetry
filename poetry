<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Poet's Poetry | Bashudev Upadhyay</title>

<style>

/* =========================
   BASIC SETTINGS
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --background: #f7f1e8;
    --card: #fffdf9;
    --text: #2c211b;
    --muted: #776b63;
    --primary: #70452e;
    --gold: #b8894f;
    --border: #e3d6c8;
}

body.dark {
    --background: #171311;
    --card: #231d19;
    --text: #f5eee8;
    --muted: #b9aaa0;
    --primary: #d4a06b;
    --gold: #c18c52;
    --border: #3b3029;
}

body {
    font-family: Georgia, "Times New Roman", serif;
    background: var(--background);
    color: var(--text);
    min-height: 100vh;
    transition: 0.3s;
}

/* =========================
   NAVIGATION
========================= */

nav {
    position: sticky;
    top: 0;
    z-index: 1000;

    background: rgba(247,241,232,0.94);
    backdrop-filter: blur(12px);

    border-bottom: 1px solid var(--border);
}

body.dark nav {
    background: rgba(23,19,17,0.94);
}

.nav-container {
    max-width: 1150px;
    margin: auto;

    padding: 15px 20px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    color: var(--primary);
    font-size: 24px;
    font-weight: bold;
}

.logo small {
    display: block;

    font-family: Arial, sans-serif;

    color: var(--muted);

    font-size: 10px;
    letter-spacing: 3px;
    margin-top: 3px;
}

.nav-links {
    display: flex;
    gap: 18px;
    align-items: center;
}

.nav-links button {
    border: none;
    background: transparent;

    color: var(--text);

    font-family: Georgia, serif;
    font-size: 15px;

    cursor: pointer;
}

.nav-links button:hover {
    color: var(--primary);
}

.theme-button {
    font-size: 20px !important;
}


/* =========================
   PAGE SYSTEM
========================= */

.page {
    display: none;
}

.page.active {
    display: block;
}


/* =========================
   HERO
========================= */

.hero {
    max-width: 1150px;

    margin: auto;

    min-height: 650px;

    padding: 80px 20px;

    display: grid;

    grid-template-columns: 1.4fr 0.6fr;

    align-items: center;

    gap: 50px;
}

.hero-title {
    font-size: clamp(50px, 7vw, 85px);

    line-height: 0.98;

    margin-bottom: 25px;
}

.hero-title span {
    color: var(--primary);
}

.hero-description {
    max-width: 650px;

    color: var(--muted);

    font-size: 20px;

    line-height: 1.8;
}

.hero-buttons {
    margin-top: 30px;

    display: flex;

    gap: 12px;

    flex-wrap: wrap;
}


/* =========================
   BUTTONS
========================= */

.btn {
    padding: 13px 22px;

    border-radius: 30px;

    border: 1px solid var(--primary);

    font-family: Georgia, serif;

    cursor: pointer;

    font-size: 15px;
}

.btn-primary {
    background: var(--primary);
    color: white;
}

.btn-secondary {
    background: transparent;
    color: var(--primary);
}

.btn:hover {
    opacity: 0.85;
}


/* =========================
   PROFILE
========================= */

.profile-card {
    background: var(--card);

    border: 1px solid var(--border);

    border-radius: 25px;

    padding: 35px;

    text-align: center;

    box-shadow: 0 15px 40px rgba(50,35,25,0.10);
}

.profile-image {
    width: 140px;
    height: 140px;

    margin: auto;
    margin-bottom: 20px;

    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    background:
        linear-gradient(
            135deg,
            var(--primary),
            var(--gold)
        );

    color: white;

    font-size: 45px;

    font-weight: bold;
}

.profile-card h2 {
    margin-bottom: 8px;
}

.profile-card p {
    color: var(--muted);

    line-height: 1.7;
}


/* =========================
   SECTIONS
========================= */

.section {
    max-width: 1150px;

    margin: auto;

    padding: 60px 20px 90px;
}

.section-title {
    font-size: 42px;

    margin-bottom: 10px;
}

.section-description {
    color: var(--muted);

    margin-bottom: 30px;

    font-size: 17px;
}


/* =========================
   SEARCH
========================= */

.search-box {
    width: 100%;

    padding: 15px 18px;

    border: 1px solid var(--border);

    border-radius: 12px;

    background: var(--card);

    color: var(--text);

    font-size: 16px;

    font-family: Georgia, serif;

    margin-bottom: 20px;
}


/* =========================
   CATEGORIES
========================= */

.categories {
    display: flex;

    flex-wrap: wrap;

    gap: 10px;

    margin-bottom: 30px;
}

.category {
    padding: 10px 18px;

    border-radius: 25px;

    border: 1px solid var(--border);

    background: var(--card);

    color: var(--text);

    cursor: pointer;

    font-family: Georgia, serif;
}

.category:hover,
.category.active {
    background: var(--primary);

    color: white;
}


/* =========================
   POETRY GRID
========================= */

.poetry-grid {
    display: grid;

    grid-template-columns:
        repeat(auto-fit, minmax(280px, 1fr));

    gap: 22px;
}


/* =========================
   POEM CARD
========================= */

.poem-card {
    background: var(--card);

    border: 1px solid var(--border);

    border-radius: 18px;

    padding: 25px;

    box-shadow:
        0 10px 30px rgba(50,35,25,0.08);

    transition: 0.25s;
}

.poem-card:hover {
    transform: translateY(-5px);
}

.language {
    color: var(--gold);

    font-family: Arial, sans-serif;

    font-size: 12px;

    letter-spacing: 2px;

    text-transform: uppercase;

    margin-bottom: 12px;
}

.poem-card h3 {
    font-size: 25px;

    margin-bottom: 12px;
}

.poem-preview {
    color: var(--muted);

    line-height: 1.8;

    white-space: pre-line;

    max-height: 130px;

    overflow: hidden;

    margin-bottom: 20px;
}

.poem-bottom {
    border-top: 1px solid var(--border);

    padding-top: 15px;

    display: flex;

    align-items: center;

    justify-content: space-between;
}

.read-button {
    border: none;

    background: none;

    color: var(--primary);

    font-family: Georgia, serif;

    font-weight: bold;

    cursor: pointer;
}

.favorite-button {
    background: none;

    border: none;

    font-size: 22px;

    cursor: pointer;

    color: var(--primary);
}


/* =========================
   ADD POETRY
========================= */

.form-container {
    max-width: 750px;

    margin: auto;

    background: var(--card);

    border: 1px solid var(--border);

    border-radius: 20px;

    padding: 35px;

    box-shadow:
        0 15px 40px rgba(50,35,25,0.10);
}

.form-group {
    margin-bottom: 22px;
}

.form-group label {
    display: block;

    margin-bottom: 8px;

    font-weight: bold;
}

.form-input,
.form-select,
.form-textarea {
    width: 100%;

    padding: 14px;

    border-radius: 10px;

    border: 1px solid var(--border);

    background: var(--background);

    color: var(--text);

    font-family: Georgia, serif;

    font-size: 16px;
}

.form-textarea {
    min-height: 320px;

    resize: vertical;

    line-height: 1.8;
}


/* =========================
   READER
========================= */

.reader {
    max-width: 800px;

    margin: auto;

    background: var(--card);

    border: 1px solid var(--border);

    border-radius: 20px;

    padding: 50px;

    box-shadow:
        0 15px 40px rgba(50,35,25,0.10);
}

.reader-language {
    color: var(--gold);

    font-family: Arial, sans-serif;

    font-size: 13px;

    letter-spacing: 3px;
}

.reader h1 {
    font-size: 45px;

    margin: 15px 0;
}

.reader-date {
    color: var(--muted);

    margin-bottom: 35px;
}

.reader-poem {
    white-space: pre-line;

    font-size: 21px;

    line-height: 2;
}


/* =========================
   ABOUT
========================= */

.about {
    max-width: 800px;

    margin: auto;

    text-align: center;
}

.about p {
    color: var(--muted);

    font-size: 19px;

    line-height: 2;
}


/* =========================
   EMPTY
========================= */

.empty {
    text-align: center;

    padding: 60px 20px;

    color: var(--muted);
}


/* =========================
   FOOTER
========================= */

footer {
    border-top: 1px solid var(--border);

    text-align: center;

    padding: 35px 20px;

    color: var(--muted);

    font-size: 14px;
}


/* =========================
   MOBILE
========================= */

@media(max-width:750px) {

    .nav-container {
        flex-direction: column;

        gap: 12px;
    }

    .nav-links {
        gap: 12px;

        flex-wrap: wrap;

        justify-content: center;
    }

    .nav-links button {
        font-size: 13px;
    }

    .hero {
        grid-template-columns: 1fr;

        padding-top: 60px;
    }

    .hero-title {
        font-size: 52px;
    }

    .hero-description {
        font-size: 17px;
    }

    .profile-card {
        max-width: 400px;

        margin: auto;
    }

    .section-title {
        font-size: 34px;
    }

    .reader {
        padding: 30px 20px;
    }

    .reader h1 {
        font-size: 34px;
    }

}

</style>
</head>


<body>


<!-- =========================
     NAVIGATION
========================= -->

<nav>

<div class="nav-container">

<div class="logo">

    Poet's Poetry

    <small>
        BASHUDEV UPADHYAY
    </small>

</div>


<div class="nav-links">

<button onclick="showPage('home')">
    Home
</button>

<button onclick="showPage('poetry')">
    Poetry
</button>

<button onclick="showPage('about')">
    About
</button>

<button onclick="showPage('add')">
    + Add Poetry
</button>

<button
    class="theme-button"
    onclick="toggleDarkMode()">

    ◐

</button>

</div>

</div>

</nav>



<!-- =========================
     HOME
========================= -->

<div id="home" class="page active">

<section class="hero">

<div>

<h1 class="hero-title">

    Poet's<br>

    <span>Poetry.</span>

</h1>


<p class="hero-description">

    Welcome to my personal collection of poetry —
    a quiet space where thoughts become words,
    emotions become verses, and memories become stories.

</p>


<div class="hero-buttons">

<button
    class="btn btn-primary"
    onclick="showPage('poetry')">

    Explore Poetry

</button>


<button
    class="btn btn-secondary"
    onclick="showPage('add')">

    Write a Poetry

</button>

</div>

</div>



<div class="profile-card">

<div class="profile-image">

    BU

</div>


<h2>
    Bashudev Upadhyay
</h2>


<p>
    Poet • Writer • Dreamer
</p>


<br>


<p>

    "Every heart has a story.
    Sometimes poetry is the language
    in which it speaks."

</p>

</div>

</section>



<section class="section">

<h2 class="section-title">
    Featured Poetry
</h2>

<p class="section-description">
    A glimpse from my collection.
</p>


<div
    id="featuredPoems"
    class="poetry-grid">

</div>

</section>

</div>



<!-- =========================
     POETRY PAGE
========================= -->

<div id="poetry" class="page">

<section class="section">

<h1 class="section-title">
    Poetry Collection
</h1>


<p class="section-description">

    Explore poems written in
    Nepali, Hindi and English.

</p>



<input
    type="text"
    id="search"
    class="search-box"
    placeholder="Search poetry..."
    oninput="displayPoems()"
>



<div class="categories">

<button
    class="category active"
    onclick="selectCategory('All',this)">

    All

</button>


<button
    class="category"
    onclick="selectCategory('Nepali',this)">

    🇳🇵 Nepali

</button>


<button
    class="category"
    onclick="selectCategory('Hindi',this)">

     Hindi

</button>


<button
    class="category"
    onclick="selectCategory('English',this)">

     English

</button>

</div>



<div
    id="poetryGrid"
    class="poetry-grid">

</div>

</section>

</div>



<!-- =========================
     ADD POETRY PAGE
========================= -->

<div id="add" class="page">

<section class="section">

<h1 class="section-title">
    Add Your Poetry
</h1>


<p class="section-description">

    Write something that deserves to be remembered.

</p>



<div class="form-container">


<div class="form-group">

<label>
    Poetry Title
</label>


<input
    id="titleInput"
    class="form-input"
    type="text"
    placeholder="Enter your poetry title"
>

</div>



<div class="form-group">

<label>
    Language
</label>


<select
    id="languageInput"
    class="form-select">

<option value="Nepali">
    Nepali
</option>

<option value="Hindi">
     Hindi
</option>

<option value="English">
     English
</option>

</select>

</div>



<div class="form-group">

<label>
    Your Poetry
</label>


<textarea
    id="textInput"
    class="form-textarea"
    placeholder="Write your poetry here...

You can write multiple lines.

