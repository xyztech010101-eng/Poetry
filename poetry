    ← Back to Poetry

</button>


</div>

</section>

</div>



<!-- =========================
     FOOTER
========================= -->

<footer>

    © 2026 Poet's Poetry
    <br>
    <br>
    By Bashudev Upadhyay

</footer>



<script>

/* =========================
   POETRY DATA
========================= */

let poems = JSON.parse(
    localStorage.getItem("poetsPoetry")
) || [

{
    id: 1,

    title: "The First Word",

    language: "English",

    text:
`Sometimes a single word
can carry a thousand thoughts.

Sometimes silence
is the longest poem.

And sometimes,
we write only to understand
what our heart already knows.`,

    date: "17 September 2026",

    favorite: false
},


{
    id: 2,

    title: "मेरो गाउँ",

    language: "Nepali",

    text:
`मेरो गाउँको बाटो
आज पनि उस्तै छ।

तर हिँड्ने पाइला
र सपनाहरू
धेरै बदलिएका छन्।`,

    date: "17 September 2026",

    favorite: false
},


{
    id: 3,

    title: "कुछ बातें",

    language: "Hindi",

    text:
`कुछ बातें कही नहीं जातीं,
बस महसूस की जाती हैं।

कुछ यादें मिटती नहीं,
बस समय के साथ
खामोश हो जाती हैं।`,

    date: "17 September 2026",

    favorite: false
}

];


let currentCategory = "All";


/* =========================
   SAVE POEMS
========================= */

function savePoems() {

    localStorage.setItem(
        "poetsPoetry",
        JSON.stringify(poems)
    );

}


/* =========================
   PAGE NAVIGATION
========================= */

function showPage(pageName) {

    document
        .querySelectorAll(".page")
        .forEach(page => {

            page.classList.remove("active");

        });


    document
        .getElementById(pageName)
        .classList.add("active");


    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });


    if(pageName === "poetry") {

        displayPoems();

    }


    if(pageName === "home") {

        displayFeatured();

    }

}


/* =========================
   CATEGORY
========================= */

function selectCategory(category, button) {

    currentCategory = category;


    document
        .querySelectorAll(".category")
        .forEach(btn => {

            btn.classList.remove("active");

        });


    button.classList.add("active");


    displayPoems();

}


/* =========================
   DISPLAY POEMS
========================= */

function displayPoems() {

    const grid =
        document.getElementById("poetryGrid");


    const search =
        document
        .getElementById("search")
        .value
        .toLowerCase();


    const filtered =
        poems.filter(poem => {

            const categoryMatch =
                currentCategory === "All" ||
                poem.language === currentCategory;


            const searchMatch =
                poem.title
                .toLowerCase()
                .includes(search)

                ||

                poem.text
                .toLowerCase()
                .includes(search);


            return categoryMatch && searchMatch;

        });


    if(filtered.length === 0) {

        grid.innerHTML = `

            <div class="empty">

                <h2>
                    No poetry found
                </h2>
    
                <p>
                    Try another category or search.
                </p>

            </div>

        `;

        return;

    }


    grid.innerHTML =
        filtered
        .map(poem => createPoemCard(poem))
        .join("");

}


/* =========================
   FEATURED POEMS
========================= */

function displayFeatured() {

    const container =
        document.getElementById("featuredPoems");


    const featured =
        poems.slice(0, 3);


    container.innerHTML =
        featured
        .map(poem => createPoemCard(poem))
        .join("");

}


/* =========================
   POEM CARD
========================= */

function createPoemCard(poem) {

    let preview =
        poem.text.length > 220
        ? poem.text.substring(0,220) + "..."
        : poem.text;


    return `

        <article class="poem-card">

            <div class="language">

                ${escapeHTML(poem.language)}

            </div>


            <h3>

                ${escapeHTML(poem.title)}

            </h3>


            <div class="poem-preview">

                ${escapeHTML(preview)}

            </div>


            <div class="poem-bottom">


                <button
                    class="read-button"
                    onclick="readPoem(${poem.id})">

                    Read poem →

                </button>


                <button
                    class="favorite-button"
                    onclick="favoritePoem(${poem.id})">

                    ${poem.favorite ? "♥" : "♡"}

                </button>


            </div>

        </article>

    `;

}


/* =========================
   READ POEM
========================= */

function readPoem(id) {

    const poem =
        poems.find(item => item.id === id);


    if(!poem) return;


    document
        .getElementById("readerLanguage")
        .innerText = poem.language;


    document
        .getElementById("readerTitle")
        .innerText = poem.title;


    document
        .getElementById("readerDate")
        .innerText =
        "Added on " + poem.date;


    document
        .getElementById("readerPoem")
        .innerText = poem.text;


    showPage("reader");

}


/* =========================
   FAVORITE
========================= */

function favoritePoem(id) {

    const poem =
        poems.find(item => item.id === id);


    if(!poem) return;


    poem.favorite =
        !poem.favorite;


    savePoems();


    displayPoems();

    displayFeatured();

}


/* =========================
   ADD POETRY
========================= */

function publishPoetry() {

    const title =
        document
        .getElementById("titleInput")
        .value
        .trim();


    const language =
        document
        .getElementById("languageInput")
        .value;


    const text =
        document
        .getElementById("textInput")
        .value
        .trim();


    if(!title) {

        alert(
            "Please enter a poetry title."
        );

        return;

    }


    if(!text) {

        alert(
            "Please write your poetry."
        );

        return;

    }


    const newPoem = {

        id: Date.now(),

        title: title,

        language: language,

        text: text,

        date:
            new Date().toLocaleDateString(
                "en-GB",
                {
                    day: "numeric",
                    month: "long",
                    year: "numeric"
                }
            ),

        favorite: false

    };


    poems.unshift(newPoem);


    savePoems();


    document
        .getElementById("titleInput")
        .value = "";

            
    document
        .getElementById("textInput")
        .value = "";


    alert(
        "✒️ Poetry published successfully!"
    );


    showPage("poetry");

}


/* =========================
   DARK MODE
========================= */

function toggleDarkMode() {

    document
        .body
        .classList
        .toggle("dark");


    localStorage.setItem(
        "poetsPoetryTheme",

        document.body.classList.contains("dark")
        ? "dark"
        : "light"
    );

}


/* =========================
   LOAD THEME
========================= */

if(
    localStorage.getItem(
        "poetsPoetryTheme"
    ) === "dark"
) {

    document.body.classList.add("dark");

}


/* =========================
   SECURITY
========================= */

function escapeHTML(text) {

    return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

}


/* =========================
   START WEBSITE
========================= */

displayFeatured();

</script>

</body>
</html>